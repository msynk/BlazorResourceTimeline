<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Multi-target so the package works on the current LTS/STS runtimes. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Ship the XML docs (the public API is thoroughly documented) and treat
         analyzer feedback as part of the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Declare the assembly trim-compatible so trimmed apps (notably Blazor
         WebAssembly, which trims on publish) can shrink it instead of skipping
         it. Everything the interop boundary reaches by reflection is rooted in
         ILLink.Descriptors.xml below; the analyzer keeps that promise honest. -->
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BlazorResourceTimeline</PackageId>
    <Version>0.3.0</Version>
    <Title>Blazor Resource Timeline</Title>
    <Authors>msynk</Authors>
    <Company>msynk</Company>
    <Product>BlazorResourceTimeline</Product>
    <Copyright>Copyright (c) 2026 Saleh Yusefnejad</Copyright>
    <Description>A high-performance resource-timeline / planner component for ASP.NET Core Blazor. Renders wide time ranges with large numbers of allocation bars, with zoom, marquee/keyboard selection, time-zone-aware axes, HiDPI rendering and streaming data load.</Description>
    <PackageTags>blazor;timeline;scheduler;gantt;planning;resource;calendar;aviation;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/msynk/BlazorResourceTimeline</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/msynk/BlazorResourceTimeline/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/msynk/BlazorResourceTimeline</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>main</RepositoryBranch>
  </PropertyGroup>

  <!-- Ship a symbol package and Source Link metadata so consumers can step into
       the library. Source Link ships in the .NET SDK, so no PackageReference is
       needed; the CI flag makes released binaries deterministic. -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <!-- Trimming roots for the types System.Text.Json reflects over at the interop
       boundary. The LogicalName is what the trimmer looks for. -->
  <ItemGroup>
    <EmbeddedResource Include="ILLink.Descriptors.xml">
      <LogicalName>ILLink.Descriptors.xml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

  <!-- Files that appear at the root of the package. LICENSE is shipped alongside
       the MIT expression so the full text travels with the package. -->
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

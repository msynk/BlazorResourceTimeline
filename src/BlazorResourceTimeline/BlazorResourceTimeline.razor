@namespace BlazorResourceTimeline
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="timeline-container">
    @* The active renderer (canvas/SVG/HTML) creates its surface element
       inside this wrapper when the JS module initializes. *@
    <div class="timeline-wrapper" @ref="_wrapperElement"
         tabindex="0" role="application" aria-label="@AriaLabel"
         aria-roledescription="Resource timeline"
         aria-keyshortcuts="@KeyShortcuts">
    </div>
    @if (TopStartContent is not null)
    {
        <div class="timeline-top-start"
             style="width:@(_layout.ResourceAxisWidth)px;height:@(_layout.TimeAxisHeight)px;">
            @TopStartContent
        </div>
    }
    @if (ResourceTemplate is not null)
    {
        <div class="timeline-resource-overlay"
             style="top:@(_layout.TimeAxisHeight)px;width:@(_layout.ResourceAxisWidth)px;">
            <div class="timeline-resource-overlay-inner" @ref="_resourceOverlayInner">
                @foreach (var row in _resourceRows)
                {
                    <div class="timeline-resource-row"
                         style="height:@((row.Height > 0 ? row.Height : _layout.ResourceHeight))px;padding-left:@(8 + row.Depth * _layout.ResourceIndent)px;">
                        @if (row.HasChildren)
                        {
                            <button type="button" class="timeline-resource-chevron"
                                    @onclick="() => ToggleGroupAsync(row.Id)"
                                    aria-label="@((row.Collapsed ? "Expand" : "Collapse") + " " + row.Name)">
                                @(row.Collapsed ? "\u25B6" : "\u25BC")
                            </button>
                        }
                        <div class="timeline-resource-content">
                            @ResourceTemplate(ContextFor(row))
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    @if (_isLoading)
    {
        <div class="timeline-loading" role="status" aria-live="polite">
            @if (LoadingContent is not null)
            {
                @LoadingContent
            }
            else
            {
                <div class="timeline-loading-spinner"></div>
                <span class="timeline-loading-text">Loading…</span>
            }
        </div>
    }
</div>

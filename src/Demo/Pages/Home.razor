    private static string DescribePointer(string kind, BlazorResourceTimelinePointerArgs args)
    {
        var target = args.Allocation is { } bar
            ? $"bar {bar.Id}"
            : args.OverflowAllocations.Count > 0
                ? $"+{args.OverflowAllocations.Count} overflow"
                : args.Resource?.Name ?? args.Area.ToString();
        var time = args.Time is { } t ? $" at {FormatTime(t)}" : "";
        return $"{kind}: {args.Area} {target}{time} ({(int)args.X},{(int)args.Y})";
    }

    private void HandleResourceAxisWidthChanged(int width)
    {
        _resourceAxisWidth = width;
        // Mutate in place so a remount (toggling the custom column) keeps the
        // dragged width without a redundant setOptions on the live instance.
        if (_options is not null)
        {
            _options.ResourceAxisWidth = width;
        }
    }


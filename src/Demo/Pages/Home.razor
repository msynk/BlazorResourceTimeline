    // Toggling on-demand loading changes which data path the component uses.
    // Assigning a new Config reference makes it reload (after the updated
    // LoadAllocationsAsync parameter has been applied).
    private void ToggleWindowed()
    {
        if (_config is not null)
        {
            _config = CloneConfig(_config);
        }
    }

    private static BlazorResourceTimelineConfig CloneConfig(BlazorResourceTimelineConfig c) => new()
    {
        Resources = c.Resources,
        StartDate = c.StartDate,
        EndDate = c.EndDate,
        Allocations = c.Allocations,
    };

    // Demo "backend" for on-demand loading: returns every allocation whose time
    // span overlaps the requested window. A real app would query a database or
    // service here instead of filtering an in-memory list.
    private Task<IReadOnlyList<BlazorResourceTimelineAllocation>> LoadWindowAsync(BlazorResourceTimelineWindow window)
    {
        IReadOnlyList<BlazorResourceTimelineAllocation> result = _config is null
            ? Array.Empty<BlazorResourceTimelineAllocation>()
            : _config.Allocations
                .Where(a => a.EndTime >= window.Start && a.StartTime <= window.End)
                .ToList();
        return Task.FromResult(result);
    }

    // An empty time-zone selection means "use the viewer's local zone" (null).
    private BlazorResourceTimelineOptions BuildOptions() => new()
    {
        TimeZone = string.IsNullOrEmpty(_timeZone) ? null : _timeZone,
        ShowUtcTime = _showUtcTime,
        // Two hour rows in the default 60px axis leave each about 19px; a little
        // more room keeps them comfortable. Sent explicitly both ways - Options
        // merges, so a null here would keep the taller axis after toggling off.
        TimeAxisHeight = _showUtcTime ? 76 : 60,
        // Keep a user-dragged resource-column width across Options rebuilds
        // (theme, renderer, …) and across the remount that toggling the custom
        // column causes.
        ResourceAxisWidth = _resourceAxisWidth,
        // Open on the current time instead of the start of the generated range,
        // and stay where the user left the view when the data is regenerated.
        AutoScrollToNow = _autoScrollToNow,
        PreserveScrollOnReload = _preserveScroll,
        PanToDayStart = _panToDayStart,
        NowLineRefreshMs = _nowRefreshMs,
        Editable = _editable,
        AllowOverlap = !_preventOverlap,
        EmptyDragAction = _createOnDrag
            ? BlazorResourceTimelineEmptyDragAction.Create
            : BlazorResourceTimelineEmptyDragAction.Marquee,
        AllowDelete = _allowDelete,
        Hour12 = _hour12,
        MaxStackLanes = _maxStackLanes,
        NonWorkingDays = _shadeWeekends ? [0, 6] : [],
        WorkingHoursStart = _shadeWeekends ? 540 : 0,
        WorkingHoursEnd = _shadeWeekends ? 1020 : 0,
        BarHeight = _barHeight,
        BarMargin = _barMargin,
        StackLabelClearance = _stackLabelClearance,
        StackOnLabelCollision = _stackOnLabelCollision,
        Renderer = _renderer switch
        {
            "svg" => BlazorResourceTimelineRendererType.Svg,
            "html" => BlazorResourceTimelineRendererType.Html,
            _ => BlazorResourceTimelineRendererType.Canvas,
        },
        // Always send a full palette: the engine merges colors and leaves prior
        // values in place when Colors is null, so light↔dark would stick otherwise.
        Colors = _darkTheme ? DarkTimelineColors : LightTimelineColors,
    };


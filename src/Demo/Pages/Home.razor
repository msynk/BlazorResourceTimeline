    // Identifies a bar in the menu-action text by its own data: label (falling
    // back to id), id, time range and duration.
    private static string DescribeBar(BlazorResourceTimelineAllocation bar)
    {
        var label = bar.TextAbove ?? bar.TextStart ?? bar.TextEnd ?? bar.TextBelow ?? bar.Id;
        return $"\"{label}\" (id {bar.Id}, {FormatTime(bar.StartTime)} – {FormatTime(bar.EndTime)}, {FormatDuration(bar.EndTime - bar.StartTime)})";
    }

    // The demo menu items don't mutate anything; the chosen action is just
    // echoed in the stats bar so the round trip is visible.
    private void RunMenuAction(string action)
    {
        _lastMenuAction = action;
        _contextMenu = null;
    }


    // The component has already applied the move/resize to this instance in
    // place; a real app would persist it here. We just surface it in the UI.
    private void HandleAllocationChanged(BlazorResourceTimelineAllocation allocation)
    {
        _lastEdit = $"{ResourceNameFor(allocation.ResourceId)} " +
            $"{FormatTime(allocation.StartTime)} \u2013 {FormatTime(allocation.EndTime)}";
        StateHasChanged();
    }

    // Host-side cancel: Database-01 is closed to incoming bars. Returning false
    // snaps the bar back without ReloadAsync.
    private Task<bool> HandleAllocationChanging(BlazorResourceTimelineAllocationChange change)
    {
        if (change.Kind == BlazorResourceTimelineAllocationChangeKind.Move
            && ResourceNameFor(change.Allocation.ResourceId) == "Database-01"
            && ResourceNameFor(change.PreviousResourceId) != "Database-01")
        {
            _lastEdit = "Refused: Database-01 does not accept incoming bars";
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private async Task<bool> HandleAllocationsChanging(
        IReadOnlyList<BlazorResourceTimelineAllocationChange> changes)
    {
        foreach (var change in changes)
        {
            if (!await HandleAllocationChanging(change))
            {
                return false;
            }
        }

        return true;
    }

    private Task<bool> HandleAllocationsDeleting(IReadOnlyList<string> ids)
    {
        if (_config is null)
        {
            return Task.FromResult(false);
        }

        var drop = ids.ToHashSet(StringComparer.Ordinal);
        _config.Allocations.RemoveAll(a => drop.Contains(a.Id));
        _lastEdit = $"Deleted {ids.Count} bar(s)";
        return Task.FromResult(true);
    }

    private Task<IReadOnlyList<BlazorResourceTimelineAllocation>?> HandleAllocationsCopying(
        BlazorResourceTimelineCopyRequest request)
    {
        var clones = new List<BlazorResourceTimelineAllocation>(request.Allocations.Count);
        foreach (var src in request.Allocations)
        {
            var clone = new BlazorResourceTimelineAllocation
            {
                Id = $"copy-{Guid.NewGuid():N}",
                ResourceId = src.ResourceId,
                StartTime = src.StartTime + request.Offset,
                EndTime = src.EndTime + request.Offset,
                Color = src.Color,
                Height = src.Height,
                TextAbove = src.TextAbove,
                TextBelow = src.TextBelow,
                TextStart = src.TextStart,
                TextEnd = src.TextEnd,
                Tooltip = src.Tooltip,
                ClassName = src.ClassName,
            };
            clones.Add(clone);
            _config?.Allocations.Add(clone);
        }

        _lastEdit = $"Pasted {clones.Count} bar(s)";
        return Task.FromResult<IReadOnlyList<BlazorResourceTimelineAllocation>?>(clones);
    }


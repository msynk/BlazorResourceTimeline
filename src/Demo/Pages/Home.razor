    private void ApplyOptions() => _options = BuildOptions();

    // Icon placement lives on the data rather than in Options, so it is edited
    // into the existing bars - no regeneration, which also makes the before and
    // after directly comparable - and published with a new Config reference.
    private void ToggleIconPlacement()
    {
        if (_config is not null)
        {
            DataGenerator.ApplyIconPlacement(_config.Allocations, _insideIcons);
            _config = CloneConfig(_config);
        }

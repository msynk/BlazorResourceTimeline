@page "/"
@using System.Text.Json
@using global::BlazorResourceTimeline
@using global::BlazorResourceTimeline.Demo.Data
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Resource Timeline - 0.8.0</PageTitle>

<div class="demo-page@(_darkTheme ? " theme-dark" : "")">
    <header class="demo-header">
        @* Actions sit on the title line; the settings below are grouped and
           compact so the header stays a thin band above the timeline. *@
        <div class="demo-titlebar">
            <h1>Resource Timeline - 0.8.0</h1>
            <div class="demo-actions">
                @* PanByDaysAsync is the same movement the page-level arrow
                   keys make, so these buttons and the shortcuts stay in step. *@
                <span class="ctl-pan">
                    Pan
                    <button class="btn-step" @onclick="() => PanAsync(-7)"
                            title="Back one week (Ctrl+←)" aria-label="Back one week">&laquo;</button>
                    <button class="btn-step" @onclick="() => PanAsync(-1)"
                            title="Back one day (←)" aria-label="Back one day">&lsaquo;</button>
                    <button class="btn-step" @onclick="() => PanAsync(1)"
                            title="Forward one day (→)" aria-label="Forward one day">&rsaquo;</button>
                    <button class="btn-step" @onclick="() => PanAsync(7)"
                            title="Forward one week (Ctrl+→)" aria-label="Forward one week">&raquo;</button>
                </span>
                <span class="ctl-zoom">
                    Zoom
                    <button class="btn-zoom" @onclick="ZoomOutAsync" title="Zoom out">&minus;</button>
                    <button class="btn-zoom" @onclick="ZoomInAsync" title="Zoom in">+</button>
                    <button class="btn-zoom" @onclick="ResetZoomAsync" title="Reset zoom">Reset</button>
                </span>
                <button class="btn-today" @onclick="GoToTodayAsync">Go to Today</button>
                <button class="btn-regenerate" @onclick="RegenerateAsync">Regenerate</button>
                <button class="btn-theme@(_darkTheme ? " is-active" : "")"
                        @onclick="ToggleThemeAsync"
                        title="@(_darkTheme ? "Switch to light theme" : "Switch to dark theme")"
                        aria-pressed="@(_darkTheme ? "true" : "false")">
                    @(_darkTheme ? "Light theme" : "Dark theme")
                </button>
                <button class="btn-code" @onclick="ToggleCode">
                    @(_showCode ? "Hide code" : "Show code")
                </button>
            </div>
        </div>

        <div class="demo-toolbar">
            <div class="ctl-group">
                <label>
                    Days
                    <select @bind="_days" @bind:after="RegenerateAsync">
                        <option value="7">7</option>
                        <option value="30">30</option>
                        <option value="100">100</option>
                        <option value="365">365</option>
                    </select>
                </label>
                <label class="ctl-check" title="Serve only the visible window on demand instead of loading all bars up front">
                    <input type="checkbox" @bind="_windowed" @bind:after="ToggleWindowed" />
                    On-demand
                </label>
            </div>

            <div class="ctl-group">
                @* ZoomToDaysAsync fits this many days into the content area
                   (the viewport minus the resource axis), leaving the time
                   under the center where it is. *@
                <span class="ctl-view" title="ZoomToDaysAsync: fit this many days into the current viewport">
                    Days in view
                    <button class="btn-step" @onclick="() => ZoomToDaysAsync(1)"
                            title="Fit one day in the viewport">1 day</button>
                    <button class="btn-step" @onclick="() => ZoomToDaysAsync(3)"
                            title="Fit three days in the viewport">3 days</button>
                    <button class="btn-step" @onclick="() => ZoomToDaysAsync(7)"
                            title="Fit seven days in the viewport">7 days</button>
                </span>
                <label class="ctl-check" title="Options.PanToDayStart: PanByDaysAsync lands on local midnight instead of shifting by exactly 24 hours">
                    <input type="checkbox" @bind="_panToDayStart" @bind:after="ApplyOptions" />
                    Pan to day start
                </label>
            </div>

            <div class="ctl-group">
                <label title="Which technology paints the timeline; behavior is identical across renderers">
                    Renderer
                    <select @bind="_renderer" @bind:after="ApplyOptions">
                        <option value="canvas">Canvas</option>
                        <option value="svg">SVG</option>
                        <option value="html">HTML</option>
                    </select>
                </label>
                <label class="ctl-check" title="Drag bars to move them in time or onto another resource, or grab an edge to resize">
                    <input type="checkbox" @bind="_editable" @bind:after="ApplyOptions" />
                    Editable
                </label>
                <label class="ctl-check" title="Options.AllowOverlap: refuse a drop onto a busy slot on the same row (touching ends are still allowed)">
                    <input type="checkbox" @bind="_preventOverlap" @bind:after="ApplyOptions" />
                    Prevent overlap
                </label>
                <label class="ctl-check" title="Options.EmptyDragAction.Create: drag an empty slot to draw a new bar (Ctrl-drag still marquees)">
                    <input type="checkbox" @bind="_createOnDrag" @bind:after="ApplyOptions" />
                    Drag empty to create
                </label>
                <label class="ctl-check" title="Options.AllowDelete: Delete/Backspace removes selected bars">
                    <input type="checkbox" @bind="_allowDelete" @bind:after="ApplyOptions" />
                    Allow delete
                </label>
                <label class="ctl-check" title="Render the resource column with a custom HTML template">
                    <input type="checkbox" @bind="_customColumn" />
                    Custom column
                </label>
            </div>

            <div class="ctl-group">
                <label class="ctl-range" title="Default bar height in pixels">
                    Bar
                    <input type="range" min="2" max="32" step="1"
                           @bind="_barHeight" @bind:event="oninput" @bind:after="ApplyOptions" />
                    <span class="ctl-value">@_barHeight px</span>
                </label>
                <label class="ctl-range" title="Vertical distance between bars that overlap in time on the same row">
                    Gap
                    <input type="range" min="0" max="16" step="1"
                           @bind="_barMargin" @bind:event="oninput" @bind:after="ApplyOptions" />
                    <span class="ctl-value">@_barMargin px</span>
                </label>
                <label class="ctl-range" title="Options.MaxStackLanes: extra bars hide behind +N (0 = unlimited)">
                    Max lanes
                    <input type="range" min="0" max="8" step="1"
                           @bind="_maxStackLanes" @bind:event="oninput" @bind:after="ApplyOptions" />
                    <span class="ctl-value">@(_maxStackLanes == 0 ? "off" : _maxStackLanes.ToString())</span>
                </label>
                <label class="ctl-check" title="Options.StackLabelClearance: spread stacked bars far enough apart for their labels and icons, not just for the bars">
                    <input type="checkbox" @bind="_stackLabelClearance" @bind:after="ApplyOptions" />
                    Label clearance
                </label>
                <label class="ctl-check" title="Options.StackOnLabelCollision: stack bars whose labels, icons or delay bars would collide, not only bars that overlap in time">
                    <input type="checkbox" @bind="_stackOnLabelCollision" @bind:after="ApplyOptions" />
                    Stack on collision
                </label>
                <label class="ctl-check" title="BarIcon.Inside: draw each bar icon within its bar, against the edge its position names, instead of beside it (bars carrying one are grown to fit)">
                    <input type="checkbox" @bind="_insideIcons" @bind:after="ToggleIconPlacement" />
                    Icons inside
                </label>
            </div>

            <div class="ctl-group">
                <label>
                    Zone
                    <select @bind="_timeZone" @bind:after="ApplyOptions">
                        <option value="">Local</option>
                        <option value="UTC">UTC (Zulu)</option>
                        <option value="America/New_York">New York</option>
                        <option value="Europe/London">London</option>
                        <option value="Europe/Berlin">Berlin</option>
                        <option value="Asia/Tokyo">Tokyo</option>
                    </select>
                </label>
                <label class="ctl-check" title="Add a second hour row, in UTC, above the time-zone row">
                    <input type="checkbox" @bind="_showUtcTime" @bind:after="ApplyOptions" />
                    UTC row
                </label>
                <label class="ctl-check" title="Options.Hour12: hour-row labels as 3 PM instead of 15">
                    <input type="checkbox" @bind="_hour12" @bind:after="ApplyOptions" />
                    12-hour
                </label>
                <label class="ctl-check" title="Options.NonWorkingDays + working hours: shade weekends and 09:00–17:00 off-hours (visual only)">
                    <input type="checkbox" @bind="_shadeWeekends" @bind:after="ApplyOptions" />
                    Shade weekends
                </label>
            </div>

            <div class="ctl-group">
                @* Options.AutoScrollToNow only applies to a timeline's first
                   load, so toggling it re-keys (and therefore remounts) the
                   component - otherwise the checkbox would look inert. *@
                <label class="ctl-check" title="Options.AutoScrollToNow: center the current time when the timeline first loads (toggling remounts it here to show the effect)">
                    <input type="checkbox" @bind="_autoScrollToNow" @bind:after="ApplyOptions" />
                    Start at now
                </label>
                <label class="ctl-check" title="Options.PreserveScrollOnReload: keep the visible time range and top row when the data reloads - scroll somewhere, then hit Regenerate">
                    <input type="checkbox" @bind="_preserveScroll" @bind:after="ApplyOptions" />
                    Keep view
                </label>
                <label title="Options.NowLineRefreshMs: how often the red now line catches up with the clock">
                    Now line
                    <select @bind="_nowRefreshMs" @bind:after="ApplyOptions">
                        <option value="1000">1s</option>
                        <option value="5000">5s</option>
                        <option value="60000">1 min</option>
                        <option value="0">Off</option>
                    </select>
                </label>
            </div>
        </div>
    </header>

    <section class="demo-stats">
        <span><strong>@LeafResourceCount</strong> resources</span>
        <span><strong>@(_config?.Allocations.Count ?? 0)</strong> allocations</span>
        <span><strong>@_days</strong> days</span>
        @if (_view is not null)
        {
            <span title="OnViewChanged: visible content range">
                View <strong>@_view.Start.ToString("d MMM")</strong>
                &ndash; <strong>@_view.End.ToString("d MMM")</strong>
            </span>
        }
        <span class="demo-keys" title="Click the timeline to give it focus and use the arrows to move between bars instead">
            <kbd>&larr;</kbd>/<kbd>&rarr;</kbd> pans a day, <kbd>Ctrl</kbd>+<kbd>&larr;</kbd>/<kbd>&rarr;</kbd> a week
        </span>
        @if (_lastEdit is not null)
        {
            <span class="last-edit">Last edit: @_lastEdit</span>
        }
        @if (_lastPointer is not null)
        {
            <span class="last-edit">@_lastPointer</span>
        }
        @if (_lastMenuAction is not null)
        {
            <span class="last-edit">Menu action: @_lastMenuAction</span>
        }
        @* Keep selection chrome in the layout even when empty so toggling
           selection does not resize the flex timeline (canvas backing-store
           resize would otherwise flash). *@
        <span class="selection@(_selectedBars.Count == 0 ? " muted" : "")">
            @if (_selectedBars.Count > 1)
            {
                <text>
                    <strong>@_selectedBars.Count</strong> bars selected
                    (@FormatDuration(SelectedTotalDuration) total)
                </text>
            }
            else if (_selectedBars.Count == 1)
            {
                <text>
                    Selected: <strong>@ResourceNameFor(_selectedBars[0].ResourceId)</strong>
                    @FormatTime(_selectedBars[0].StartTime) &ndash; @FormatTime(_selectedBars[0].EndTime)
                    (@FormatDuration(_selectedBars[0].EndTime - _selectedBars[0].StartTime))
                </text>
            }
            else
            {
                <text>No bar selected &mdash; drag to marquee-select, Ctrl+click to toggle, Shift+click for a range</text>
            }
        </span>
        <button class="btn-clear@(_selectedBars.Count == 0 ? " is-placeholder" : "")"
                disabled="@(_selectedBars.Count == 0)"
                aria-hidden="@(_selectedBars.Count == 0)"
                @onclick="ClearSelectionAsync">Clear</button>
        <button class="btn-clear@(_selectedBars.Count == 0 ? " is-placeholder" : "")"
                disabled="@(_selectedBars.Count == 0)"
                title="ScrollToAllocationAsync"
                @onclick="ScrollToSelectedAsync">Go to</button>
    </section>

    <div class="demo-timeline">
        @if (_config is not null)
        {
            <BlazorResourceTimeline @ref="_timeline"
                              @key="(_customColumn, _autoScrollToNow)"
                              Config="_config"
                              Options="_options"
                              LoadAllocationsAsync="@(_windowed ? LoadWindowAsync : null)"
                              ResourceTemplate="@(_customColumn ? ColumnTemplate : null)"
                              OnSelectionChanged="HandleSelectionChanged"
                              OnViewChanged="HandleViewChanged"
                              OnAllocationChanged="HandleAllocationChanged"
                              OnAllocationChanging="HandleAllocationChanging"
                              OnAllocationsChanging="HandleAllocationsChanging"
                              OnAllocationsDeleting="HandleAllocationsDeleting"
                              OnAllocationsCopying="HandleAllocationsCopying"
                              OnAllocationCreating="HandleAllocationCreating"
                              OnContextMenu="ShowContextMenu"
                              OnClick="HandleClick"
                              OnDoubleClick="HandleDoubleClick"
                              OnResourceAxisWidthChanged="HandleResourceAxisWidthChanged">
                <TooltipTemplate>
                    <div class="demo-tip">
                        <span class="demo-tip-badge">@ResourceNameFor(context.ResourceId)</span>
                        <div>@(string.IsNullOrEmpty(context.Tooltip) ? context.Id : context.Tooltip)</div>
                    </div>
                </TooltipTemplate>
                <TopStartContent>
                    <div class="corner">
                        <span class="corner-title">Resources</span>
                        <span class="corner-sub">@(_showUtcTime ? "UTC / zone" : "Hour")</span>
                    </div>
                </TopStartContent>
            </BlazorResourceTimeline>
        }
        @if (_isGenerating || _config is null)
        {
            <div class="demo-loading" role="status" aria-live="polite">
                <span class="demo-loading-spinner"></span>
                <span>Generating timeline data&hellip;</span>
            </div>
        }
        @* Code sample is overlaid on top of the timeline rather than replacing
           it, so the canvas stays mounted and sized. Toggling is instant and the
           renderer never has to re-initialize or reload data. *@
        <div class="demo-code @(_showCode ? "is-visible" : null)" aria-hidden="@(!_showCode)">
            <div class="demo-code-header">
                <span>Sample usage</span>
                <button class="btn-copy" @onclick="CopyCodeAsync">
                    @(_codeCopied ? "Copied!" : "Copy")
                </button>
            </div>
            <pre><code>@CodeSample</code></pre>
        </div>
    </div>
</div>

@* Dummy context menu showcasing OnContextMenu: rendered at the reported
   viewport position; the items only surface the chosen action in the stats
   bar. The transparent backdrop closes it on any click outside. *@
@if (_contextMenu is not null)
{
    <div class="ctx-backdrop"
         @onclick="CloseContextMenu"
         @oncontextmenu="CloseContextMenu" @oncontextmenu:preventDefault></div>
    @* min() keeps the menu inside the viewport when the click lands near the
       right/bottom edge; the offsets roughly cover the menu's max size. The
       menu takes focus when it opens so Escape can close it. *@
    <div class="ctx-menu" tabindex="-1" @ref="_ctxMenuElement" @onkeydown="HandleMenuKeyDown"
         style="left:min(@((int)_contextMenu.ClientX)px, calc(100vw - 250px));top:min(@((int)_contextMenu.ClientY)px, calc(100vh - 200px))">
        @if (_contextMenu.Allocation is { } bar)
        {
            <div class="ctx-menu-header">
                @ResourceNameFor(bar.ResourceId) &middot;
                @FormatTime(bar.StartTime) &ndash; @FormatTime(bar.EndTime)
            </div>
            <button @onclick="@(() => RunMenuAction($"Edit {DescribeBar(bar)}"))">
                Edit allocation&hellip;
            </button>
            <button @onclick="@(() => RunMenuAction($"Duplicate {DescribeBar(bar)}"))">
                Duplicate allocation
            </button>
            <button class="ctx-menu-danger"
                    @onclick="@(() => RunMenuAction($"Delete {DescribeBar(bar)}"))">
                Delete allocation
            </button>
        }
        else if (_contextMenu.Time is { } time)
        {
            <div class="ctx-menu-header">
                @(_contextMenu.Resource?.Name ?? "Timeline") &middot; @FormatTime(time)
            </div>
            <button @onclick="@(() => RunMenuAction($"New allocation at {FormatTime(time)} on {_contextMenu.Resource?.Name ?? "timeline"}"))">
                New allocation here&hellip;
            </button>
            <button @onclick="@(() => RunMenuAction($"Paste at {FormatTime(time)}"))">
                Paste
            </button>
        }
        else if (_contextMenu.Resource is { } resource)
        {
            <div class="ctx-menu-header">@resource.Name</div>
            <button @onclick="@(() => RunMenuAction($"Rename resource {resource.Name}"))">
                Rename resource&hellip;
            </button>
            <button @onclick="@(() => RunMenuAction($"Add child resource under {resource.Name}"))">
                Add child resource
            </button>
        }
    </div>
}

@code {
    private BlazorResourceTimeline? _timeline;
    private BlazorResourceTimelineConfig? _config;
    private IReadOnlyList<BlazorResourceTimelineAllocation> _selectedBars = Array.Empty<BlazorResourceTimelineAllocation>();
    private BlazorResourceTimelineView? _view;
    private int _days = 30;
    private int _barHeight = 4;
    private int _barMargin = 2;
    private int _resourceAxisWidth = 150;
    private string _renderer = "canvas";
    private string _timeZone = "";
    private bool _showUtcTime;
    private bool _editable;
    private bool _preventOverlap;
    private bool _createOnDrag;
    private bool _allowDelete;
    private bool _hour12;
    private bool _shadeWeekends;
    private int _maxStackLanes;
    private bool _stackLabelClearance = true;
    private bool _stackOnLabelCollision = true;
    private bool _insideIcons;
    private bool _windowed;
    private bool _customColumn;
    private bool _darkTheme;
    private bool _autoScrollToNow = true;
    private bool _preserveScroll = true;
    private bool _panToDayStart;
    private int _nowRefreshMs = 60000;
    private DotNetObjectReference<Home>? _selfRef;
    private string? _lastEdit;

    // Right-click state: the args of the open context menu (null when closed)
    // and the last dummy action chosen, surfaced in the stats bar.
    private BlazorResourceTimelineContextMenuArgs? _contextMenu;
    private string? _lastMenuAction;
    private string? _lastPointer;
    private ElementReference _ctxMenuElement;
    private bool _ctxMenuFocusPending;

    // Custom resource-column template: a colored dot + bold name, and a "group"
    // badge on parent rows (the chevron is added by the component automatically).
    private RenderFragment<BlazorResourceTimelineRowContext> ColumnTemplate => row =>
        @<span class="res-cell">
            <span class="res-dot" style="background:@DotColor(row)"></span>
            <span class="res-name">@row.Resource.Name</span>
            @if (row.HasChildren)
            {
                <span class="res-badge">group</span>
            }
        </span>;

    private string DotColor(BlazorResourceTimelineRowContext row) =>
        row.HasChildren
            ? (_darkTheme ? "#868e96" : "#adb5bd")
            : (_darkTheme ? "#74c0fc" : "#1971c2");

    // A new Options instance is assigned on change so the component re-applies
    // it (Options is compared by reference, like Config).
    private BlazorResourceTimelineOptions? _options;
    private bool _isGenerating;
    private bool _showCode;
    private bool _codeCopied;
    private CancellationTokenSource? _generationCts;

    private const string CodeSample = """
        @page "/timeline"
        @using BlazorResourceTimeline

        <BlazorResourceTimeline Config="_config"
                                OnSelectionChanged="HandleSelectionChanged"
                                OnClick="HandleClick"
                                OnDoubleClick="HandleDoubleClick"
                                OnContextMenu="HandleContextMenu" />

        @code {
            // All render data is bundled into a single Config instance. Assign a
            // new instance to re-render the timeline.
            private readonly BlazorResourceTimelineConfig _config = new()
            {
                Resources = new()
                {
                    new BlazorResourceTimelineResource { Id = "r1", Name = "Server A" },
                    new BlazorResourceTimelineResource { Id = "r2", Name = "Server B" },
                    new BlazorResourceTimelineResource { Id = "r3", Name = "Database" },
                },
                StartDate = DateTimeOffset.UtcNow.AddHours(-12),
                EndDate = DateTimeOffset.UtcNow.AddHours(12),
                Allocations = new()
                {
                    new BlazorResourceTimelineAllocation
                    {
                        Id = "c1",
                        ResourceId = "r1",
                        StartTime = DateTimeOffset.UtcNow.AddHours(-6).ToUnixTimeMilliseconds(),
                        EndTime = DateTimeOffset.UtcNow.AddHours(-2).ToUnixTimeMilliseconds(),
                        Color = "#1971c2",
                        // Optional per-bar height in pixels (defaults to a thin bar).
                        Height = 12,
                        TextAbove = "Batch job",
                        // Custom icons can be anchored at the start, end, above or
                        // below the bar, or centered on top of it. Inside draws
                        // the icon within the bar, against that same edge.
                        // Source is any image URL or data URI.
                        Icons = new List<BlazorResourceTimelineBarIcon>
                        {
                            new() { Source = "/icons/check.svg", Position = BlazorResourceTimelineBarIconPosition.Start },
                            new() { Source = "/icons/star.svg", Position = BlazorResourceTimelineBarIconPosition.End, Size = 18 },
                            new() { Source = "/icons/lock.svg", Position = BlazorResourceTimelineBarIconPosition.Center, Size = 10 },
                            new() { Source = "/icons/flag.svg", Position = BlazorResourceTimelineBarIconPosition.End, Inside = true, Size = 10 },
                        },
                    },
                    new BlazorResourceTimelineAllocation
                    {
                        Id = "c2",
                        ResourceId = "r2",
                        StartTime = DateTimeOffset.UtcNow.AddHours(-1).ToUnixTimeMilliseconds(),
                        EndTime = DateTimeOffset.UtcNow.AddHours(3).ToUnixTimeMilliseconds(),
                        Color = "#e8590c",
                        TextStart = "08:30",
                        TextEnd = "12:30",
                        // Decorative edge bars extend before/after the main bar,
                        // e.g. to show a delay around the planned period.
                        StartBar = new BlazorResourceTimelineEdgeBar { Duration = 30 * 60 * 1000, Color = "red" },
                        EndBar = new BlazorResourceTimelineEdgeBar { Duration = 45 * 60 * 1000, Color = "red" },
                        Icons = new List<BlazorResourceTimelineBarIcon>
                        {
                            new() { Source = "/icons/warning.svg", Position = BlazorResourceTimelineBarIconPosition.Above },
                        },
                    },
                    new BlazorResourceTimelineAllocation
                    {
                        Id = "c3",
                        ResourceId = "r3",
                        StartTime = DateTimeOffset.UtcNow.AddHours(2).ToUnixTimeMilliseconds(),
                        EndTime = DateTimeOffset.UtcNow.AddHours(8).ToUnixTimeMilliseconds(),
                        Color = "#2f9e44",
                        TextBelow = "Maintenance",
                        Icons = new List<BlazorResourceTimelineBarIcon>
                        {
                            new() { Source = "/icons/lock.svg", Position = BlazorResourceTimelineBarIconPosition.Start, Size = 16 },
                        },
                    },
                },
            };

            private void HandleSelectionChanged(BlazorResourceTimelineAllocation[] selected)
            {
                // selected contains every currently selected bar (empty when none).
                foreach (var bar in selected)
                {
                    Console.WriteLine($"Selected {bar.Id} on {bar.ResourceId}");
                }
            }

            private void HandleContextMenu(BlazorResourceTimelineContextMenuArgs args)
            {
                // Raised on right-click (the native browser menu is suppressed).
                // args identifies what was hit - Allocation (null on empty space),
                // Resource and Time - plus ClientX/ClientY to position your menu.
                Console.WriteLine($"Context menu on {args.Allocation?.Id ?? args.Resource?.Id}");
            }

            private void HandleClick(BlazorResourceTimelinePointerArgs args)
            {
                Console.WriteLine($"Click {args.Area} at {args.Time} on {args.Resource?.Name}");
            }

            private void HandleDoubleClick(BlazorResourceTimelinePointerArgs args)
            {
                Console.WriteLine($"Double-click {args.Allocation?.Id ?? "(empty)"}");
            }
        }
        """;

    protected override async Task OnInitializedAsync()
    {
        // Theme first, so the first Options (and the first timeline paint) already
        // match the system scheme. Reading it in OnAfterRenderAsync used to assign
        // a second Options after mount and, together with OnViewChanged, replay
        // the data load two or three times.
        await InitializeThemeFromSystemAsync();
        _options = BuildOptions();
        await RegenerateAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("registerDemoPanKeys", _selfRef);
            }
            catch
            {
                // Demo-only helper; ignore if the host page omitted it.
            }
        }

        // Focus the freshly opened menu so Escape (and tabbing to the items)
        // works without an extra click.
        if (_ctxMenuFocusPending && _contextMenu is not null)
        {
            _ctxMenuFocusPending = false;
            await _ctxMenuElement.FocusAsync();
        }
    }

    private async Task InitializeThemeFromSystemAsync()
    {
        try
        {
            var preferred = await JS.InvokeAsync<string>("getPreferredDemoTheme");
            _darkTheme = preferred == "dark";
            await ApplyDocumentThemeAsync();
        }
        catch
        {
            await ApplyDocumentThemeAsync();
        }
    }

    private async Task RegenerateAsync()
    {
        // A new request supersedes any in-flight generation: cancel it so the
        // running loop bails out and the latest selection wins immediately.
        _generationCts?.Cancel();
        _generationCts?.Dispose();
        var cts = new CancellationTokenSource();
        _generationCts = cts;
        var token = cts.Token;

        // Show the generating overlay and let it paint before the heavy work
        // starts. The existing timeline (if any) stays mounted underneath so the
        // overlay is continuous through generation and into the renderer's own
        // loading spinner once the new data is handed over.
        _selectedBars = Array.Empty<BlazorResourceTimelineAllocation>();
        _isGenerating = true;
        StateHasChanged();
        // Task.Yield flushes the render batch but doesn't reliably yield a browser
        // paint on WebAssembly; a 1 ms delay does, so the overlay shows first.
        await Task.Delay(1);

        try
        {
            var config = await DataGenerator.GenerateSampleDataAsync(_days, token);

            // Ignore a result that has been superseded by a newer request.
            if (token.IsCancellationRequested)
            {
                return;
            }

            DataGenerator.ApplyIconPlacement(config.Allocations, _insideIcons);
            if (config.Allocations.Count > 0)
            {
                config.Allocations[0].ClassName = "demo-striped";
            }
            _config = config;
        }
        catch (OperationCanceledException)
        {
            // Superseded mid-run; the newer request owns the UI state.
        }
        finally
        {
            if (_generationCts == cts)
            {
                _isGenerating = false;
                _generationCts.Dispose();
                _generationCts = null;
            }
        }
    }

